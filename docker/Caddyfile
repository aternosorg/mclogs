{
    servers {
        trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
        trusted_proxies_strict
    }

    frankenphp {
        worker /app/worker.php {
            num {$FRANKENPHP_WORKERS:16}
        }
    }
}

# Internal listener for the Prometheus metrics endpoint of the app.
# It only exists when MCLOGS_METRICS_ENABLED is "true": the import below then picks
# the snippet with the listener, otherwise the empty one.
(metrics_listener_true) {
    http://:{$MCLOGS_METRICS_PORT:9464} {
        root * /app
        rewrite * /worker.php
        php_server {
            # Tells the app on which port the request really arrived,
            # the public listener below never sets this.
            env MCLOGS_LISTENER_PORT {http.request.local.port}
        }
    }
}

(metrics_listener_false) {
}

import metrics_listener_{$MCLOGS_METRICS_ENABLED:false}

{$SERVER_NAME::80} {
    root * /app/web/public
    encode zstd br gzip

    @static file
    handle @static {
        file_server
    }

    @multipart header_regexp Content-Type (?i)^\s*multipart/
    handle @multipart {
        respond "Unsupported Content-Type" 415
    }

    handle {
       root * /app
       rewrite * /worker.php
       php_server
    }
}